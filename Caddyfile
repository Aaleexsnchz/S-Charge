# SITE_ADDRESS comes from the server-side root .env (see .env.example).
# A bare domain gets automatic Let's Encrypt TLS + HTTP->HTTPS redirect.
{$SITE_ADDRESS}

encode zstd gzip

# OWASP Secure Headers, minus the entries that would break this app. Two are
# deliberately omitted rather than forgotten:
#   - Cross-Origin-Embedder-Policy: require-corp would block the OpenFreeMap
#     tiles, which are cross-origin and send no CORP header.
#   - Permissions-Policy geolocation=() would kill the "where am I" button;
#     it is allowed for this origin only.
# The full Content-Security-Policy stays a Phase 14 item, because MUI and
# Emotion inject inline <style> tags and would force style-src 'unsafe-inline'.
# frame-ancestors ships now regardless: it takes no default-src fallback, so it
# constrains framing without restricting scripts or styles.
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Content-Security-Policy "frame-ancestors 'none'"
	X-Frame-Options "DENY"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	X-Permitted-Cross-Domain-Policies "none"
	Cross-Origin-Opener-Policy "same-origin"
	Cross-Origin-Resource-Policy "same-origin"
	Permissions-Policy "geolocation=(self), accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=(), clipboard-read=(), hid=(), idle-detection=(), interest-cohort=(), serial=()"
	-Server
}

# The backend audits and rate-limits on X-Forwarded-For. Caddy is what makes
# that value trustworthy: with no `trusted_proxies` set it discards whatever the
# client sent and writes the real peer. Adding `trusted_proxies` here — to put a
# CDN in front, say — would make Caddy preserve the client's value instead.
handle /api/* {
	reverse_proxy backend:8000
}

handle {
	reverse_proxy frontend:8080
}
