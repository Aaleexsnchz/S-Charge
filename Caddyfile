# SITE_ADDRESS comes from the server-side root .env (see .env.example).
# A bare domain gets automatic Let's Encrypt TLS + HTTP->HTTPS redirect.
{$SITE_ADDRESS}

encode zstd gzip

header Strict-Transport-Security "max-age=31536000"

handle /api/* {
	reverse_proxy backend:8000
}

handle {
	reverse_proxy frontend:80
}
