# Root .env — read by docker-compose.prod.yml for variable interpolation.
# Server-side only; the dev stack (docker-compose.yml) does not need it.

# Public address Caddy serves. A bare domain enables automatic HTTPS.
# Locally you can test the prod stack with SITE_ADDRESS=localhost
# (self-signed cert, browser warning is expected).
SITE_ADDRESS=example.duckdns.org
