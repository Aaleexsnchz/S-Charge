# The project's only env file. Copy to `.env` and fill in.
#
# Read by the backend (pydantic-settings) and by both Compose files, and by
# nothing else — the frontend has no environment variables, and any that
# appear must go in frontend/.env, never here: Vite would bundle them.
#
# Real environment variables override this file, which is how CI injects an
# ephemeral SECRET_KEY.
#
# Values must not contain `$`. Compose truncates at the first one and only
# warns, so the container silently gets half a password. `openssl rand -hex 32`
# is safe.

# ---------- required in production ----------
# The app refuses to start with ENVIRONMENT=production if any of these is
# missing or still holds the development value below.

# Signs the session cookie, the password-reset token and the verification
# token. Anyone who knows it can forge a session for any account.
SECRET_KEY=change_me_secret_key
# Dev runs the backend natively, so Postgres is on localhost. The prod stack
# runs it as a container and uses @db:5432.
DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@localhost:5432/app_db
# Absolute base URL of the SPA. Builds the verify/reset links in emails.
APP_BASE_URL=http://localhost:5173
# Proxied through Vite (:5173) to the backend (:8000) so the session cookie
# lands on the same origin the SPA uses.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---------- Postgres ----------
# Consumed by the `db` container. DATABASE_URL above must agree with these.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=app_db
# Created and dropped per pytest session by tests/conftest.py.
TEST_DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@localhost:5432/app_db_test

# ---------- app ----------
# APP_VERSION is deliberately absent. It is a build argument baked into the
# image from the git tag; Compose applies env_file at container creation, so a
# line here would override it and pin /api/health to that value forever.
# `development` or `production`. Production turns on the checks above.
ENVIRONMENT=development
# Comma-separated. Prod is same-origin behind Caddy, so it sets this empty and
# no cross-origin browser can make credentialed API calls.
CORS_ALLOW_ORIGINS=http://localhost:5173
SESSION_TOKEN_EXPIRE_DAYS=14
# False for local dev — http://localhost has no TLS. True everywhere else.
SESSION_COOKIE_SECURE=true

# ---------- Caddy (prod stack only) ----------
# Public address Caddy serves; a bare domain enables automatic HTTPS.
# `just prod-up` locally wants localhost, which serves a self-signed cert.
SITE_ADDRESS=s-charge.app

# ---------- Google OAuth ----------
# Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID -> Web.
# Authorised JavaScript origin: http://localhost:5173
# Leave empty to run without Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- email (Resend) ----------
# API key at https://resend.com/api-keys. Leave empty to run without email.
# In the Resend sandbox the only sender is onboarding@resend.dev and it
# delivers only to the address owning the account, so locally you will see
# verification mail arrive at YOUR inbox and nobody else's.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# ---------- external APIs ----------
# REVE (Spanish public charging network), the seed source. Auth is
# `Authorization: Bearer <key>`. Spec: https://www.mapareve.es/docs/api/external/v1
REVE_API_KEY=
REVE_API_BASE_URL=https://www.mapareve.es/api/external/v1
# Requests per refresh run, against REVE's 5 req/hr cap.
REVE_BUDGET_PER_RUN=5
# How far back a refresh asks for tariffs. Wider windows time out on REVE's
# side; 2h is a span known to answer.

# REE (electricity prices, PVPC). No key required.
REE_API_BASE_URL=https://apidatos.ree.es
