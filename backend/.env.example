# Postgres (used by db service and backend service)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=app_db

# Backend
# DATABASE_URL uses the Docker service name "db". When running backend outside
# Docker (e.g., `uv run uvicorn` on host), override with @localhost:5432.
DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@db:5432/app_db
# Test DB. Created/dropped per pytest session by tests/conftest.py.
TEST_DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@db:5432/app_db_test
SECRET_KEY=change_me_secret_key
ACN_API_TOKEN=
APP_DEBUG=true
# Environment label. Set to `production` on Hetzner deploy in phase 6.
ENVIRONMENT=development

# Auth (single JWT in HttpOnly cookie). Defaults match auth-decisions §4 and §5.
SESSION_TOKEN_EXPIRE_DAYS=14
# Set to false for local dev (http://localhost has no TLS); keep true in prod.
SESSION_COOKIE_SECURE=true
