# Postgres (used by db service and backend service)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=app_db

# Backend
# DATABASE_URL uses the Docker service name "db". When running backend outside
# Docker (e.g., `uv run uvicorn` on host), override with @localhost:5432.
DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@db:5432/app_db
# Test DB. Created/dropped per pytest session by tests/conftest.py.
TEST_DATABASE_URL=postgresql+asyncpg://app_user:change_me_db_password@db:5432/app_db_test
SECRET_KEY=change_me_secret_key
APP_DEBUG=true
# Comma-separated CORS origins. Prod is same-origin behind Caddy — set it empty
# there so no cross-origin browser can make credentialed API calls.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Environment label. Set to `production` on Hetzner deploy in phase 6.
ENVIRONMENT=development

# Auth (single JWT in HttpOnly cookie). Defaults match auth-decisions §4 and §5.
SESSION_TOKEN_EXPIRE_DAYS=14
# Set to false for local dev (http://localhost has no TLS); keep true in prod.
SESSION_COOKIE_SECURE=true

# Google OAuth 2.0. Create the client in Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Web application).
# Authorised JavaScript origin:   http://localhost:5173
# Authorised redirect URI:        http://localhost:5173/api/auth/google/callback
# The redirect URI is proxied through Vite (:5173) to the backend (:8000) so
# the session cookie lands on the same origin the SPA uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Email (Resend). Create an API key at https://resend.com/api-keys.
# In the Resend sandbox the only sender is `onboarding@resend.dev` and it
# only delivers to the email address that owns the Resend account — so for
# local dev you'll only see verification/reset emails arrive at YOUR inbox.
# In phase 6, swap MAIL_FROM for an address on a verified domain.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
# Absolute base URL of the SPA, used to build verify/reset links in emails.
APP_BASE_URL=http://localhost:5173

# REVE API (Spanish public charging network). Phase 2.
# Auth scheme: `Authorization: Bearer <REVE_API_KEY>`.
# Request access and consult the spec at https://www.mapareve.es/docs/api/external/v1.
REVE_API_KEY=
REVE_API_BASE_URL=https://www.mapareve.es/api/external/v1
